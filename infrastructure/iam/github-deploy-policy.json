{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListWebBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::greenbyte-dev-web"
    },
    {
      "Sid": "SyncWebBucketObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:HeadObject"
      ],
      "Resource": "arn:aws:s3:::greenbyte-dev-web/*"
    },
    {
      "Sid": "InvalidateCloudFront",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateInvalidation",
        "cloudfront:GetInvalidation"
      ],
      "Resource": "arn:aws:cloudfront::421800335080:distribution/E38QB192T37GLT"
    }
  ]
}
