AWS_REGION=us-east-1
STAGE=dev
LOG_LEVEL=info
PROJECT_SLUG=greenbyte
SERVICE_NAME=greenbyte-backend
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
DATABASE_URL=
# Plant queue read (gold.v_open_queue). Use DATABASE_URL or the PG* vars. Do not commit the password.
PGHOST=
PGPORT=5432
PGDATABASE=greenbyte
PGUSER=greenbyte_user
PGPASSWORD=
PGSSL=require
# Semantic planner (core-api). Saving needs gold.replan to read plan_event.payload.entries.
SEMANTIC_PLANNER_ENABLED=false
# Bedrock explanations; off uses the template explanation.
BEDROCK_ENABLED=false
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# JEV note classifier through OpenRouter. Keep the key in SSM for deploys.
JEV_ENABLED=false
OPENROUTER_API_KEY=
