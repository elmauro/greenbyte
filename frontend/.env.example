VITE_APP_NAME=greenbyte-frontend
VITE_API_BASE_AUTH=
# Live BFF (Mauricio core-api). Leave empty with MSW or static in-process demo.
VITE_API_BASE_APP=
VITE_PROGRAM_ID=

# true = MSW mocks BFF (/demo/plant/*). false = in-process plantDemoServer OR live BFF if API_BASE set.
VITE_USE_MSW=false

# Optional gate for /demo/plant/ux (hackathon demo — override in .env.local)
# VITE_DEMO_PLANT_USERNAME=greenbyte_user
